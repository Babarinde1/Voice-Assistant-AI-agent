# Copy this file to ".env" and fill it in. Never share or commit ".env".

AI_API_KEY=put-your-key-here
# The exact model name from your provider's current model list:
AI_MODEL=

# Leave empty to use the provider's normal cloud endpoint.
# For a local model server, set its address, e.g. Ollama:
# AI_BASE_URL=http://localhost:11434/v1
# (local servers usually ignore the key, but the field must not be empty; any text works)
AI_BASE_URL=

# --- Speech recognition (Stage 3), all optional ---
# Model size: tiny.en (fastest), base.en (default), small.en (most accurate, slowest).
STT_MODEL=base.en
STT_LANGUAGE=en
STT_CPU_THREADS=4
# Microphone number from audio_check.py. Leave empty for the Windows default.
AUDIO_INPUT_DEVICE=

# --- Wake-word detection (Stage 4) ---
# Detection score threshold; lower may detect more often but can cause false activations.
WAKE_WORD_THRESHOLD=0.5
# Boost for a quiet microphone (1.0 = off). `python wake_test.py` recommends a value.
MIC_GAIN=1.0

# Stage 5: offline speech output
TTS_ENABLED=true
TTS_RATE=175
TTS_VOLUME=1.0

# Stage 6 operational logging
LOG_LEVEL=INFO

# --- Stage 8: hands-free speech and the orb ---
# true = Jarvis detects when you start and stop speaking (no Enter key).
AUTO_ENDPOINT=true
# auto uses the neural detector if available, else a volume-based one. Or: silero / energy
VAD_ENGINE=auto
# How long a pause (milliseconds) means "I finished my request".
END_SILENCE_MS=900
# Give up if you say nothing for this many seconds after "Hey Jarvis".
NO_SPEECH_TIMEOUT_S=6
# Ignore this long after the wake phrase so "...jarvis" is not part of your request.
WAKE_GRACE_MS=200
WAKE_CHIME=true
# auto | qt (transparent, colorful) | tk (simple) | off
ORB_STYLE=auto

# --- Stage 9: "do what I ask" agent ---
# The agent needs AI_API_KEY and AI_MODEL above. It can only use approved tools.
AGENT_ENABLED=true
AGENT_MAX_ROUNDS=4
# Extra folders the file tools may use, separated by semicolons (optional):
# ALLOWED_FOLDERS=D:\School;D:\Projects
# Dangerous things stay OFF until you turn them on. Even then Jarvis asks "yes or no?" first.
ALLOW_FILE_DELETION=false
ALLOW_POWER_ACTIONS=false

# After Jarvis asks a question, it keeps listening for your answer (no wake word needed).
FOLLOW_UP_ENABLED=true
FOLLOW_UP_MAX_TURNS=3
FOLLOW_UP_WAIT_SECONDS=8
